<div class="max-w-2xl mx-auto mt-4 mb-10">
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 md:p-8">

        <div class="flex items-center justify-between mb-6 border-b border-slate-100 pb-4">
            <h2 class="text-xl font-bold text-slate-800 m-0">Compose Email Campaign</h2>
            <a href="/dashboard/campaigns"
                class="text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-lg hover:bg-slate-100"
                title="Back to Logs">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                    </path>
                </svg>
            </a>
        </div>

        <form action="/dashboard/campaigns" method="POST" class="space-y-5">

            <div>
                <label for="subject" class="block text-sm font-semibold text-slate-700 mb-1">
                    Email Subject / Title *
                </label>
                <input type="text" id="subject" name="subject" required
                    class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-colors"
                    placeholder="Enter campaign subject..." />
            </div>

            <div>
                <label for="newsPostId" class="block text-sm font-semibold text-slate-700 mb-1">
                    Link to News Post / Property <span class="text-slate-400 font-normal">(Optional)</span>
                </label>
                <select id="newsPostId" name="newsPostId"
                    class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-colors cursor-pointer">
                    <option value="">-- None (Standalone Message) --</option>
                    <% newsPosts.forEach(post=> { %>
                        <option value="<%= post.id %>">
                            <%= post.title %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <div>
                <label for="body" class="block text-sm font-semibold text-slate-700 mb-1">
                    Email Body (HTML or Plain Text) *
                </label>
                <textarea id="body" name="body" rows="8" required
                    class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-colors resize-y"
                    placeholder="Write your campaign content here..."></textarea>
            </div>

            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-4 border-t border-slate-100">
                <a href="/dashboard/campaigns"
                    class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-lg transition-colors focus:ring-2 focus:ring-slate-300 inline-flex items-center justify-center text-center">
                    Cancel
                </a>
                <button type="submit"
                    class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-sm flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                    </svg>
                    Send to All Subscribers
                </button>
            </div>

        </form>
    </div>
</div>