<div class="toolbar">
  <div class="toolbar-filters">
    <input type="text" id="searchInput" placeholder="Search title, section..." class="input" />
  </div>
  <button class="btn btn-primary" id="openCreateBtn">+ New Content Block</button>
</div>

<div id="alertBox"></div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Section ID</th>
        <th>Section Title</th>
        <th>Updated</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="tableBody">
      <tr><td colspan="5" class="empty-row">Loading...</td></tr>
    </tbody>
  </table>
</div>

<!-- Modal -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="modal-header">
      <h2 id="modalTitle">New Content Block</h2>
      <button class="modal-close" id="modalCloseBtn">&times;</button>
    </div>
    <form id="postForm" class="modal-body">
      <input type="hidden" id="pageId" />

      <label for="title">Page Title *</label>
      <input type="text" id="title" required class="input" />

      <div class="form-row">
        <div>
          <label for="sectionId">Section ID *</label>
          <input type="text" id="sectionId" required class="input" placeholder="hero, about, footer..." />
        </div>
        <div>
          <label for="sectionTitle">Section Title *</label>
          <input type="text" id="sectionTitle" required class="input" />
        </div>
      </div>

      <label for="sectionSubtitle">Section Subtitle</label>
      <input type="text" id="sectionSubtitle" class="input" />

      <label for="sectionBody">Section Body *</label>
      <textarea id="sectionBody" rows="6" required class="input"></textarea>

      <label for="imageUrl">Image URL</label>
      <input type="text" id="imageUrl" class="input" />

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Content</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/page-content.js" defer></script>
