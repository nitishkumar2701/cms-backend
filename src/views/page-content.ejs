<!-- Top Toolbar -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">

  <!-- Search -->
  <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
    <div class="relative w-full sm:w-80">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <input type="text" id="searchInput" placeholder="Search title, section..."
        class="w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow shadow-sm" />
    </div>
  </div>

  <!-- Action Button -->
  <button id="openCreateBtn"
    class="flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 shadow-sm shadow-blue-600/30 transition-all focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
    </svg>
    New Content Block
  </button>
</div>

<div id="alertBox"></div>

<!-- Data Table -->
<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-10">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 text-sm data-table">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Page Title</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Section ID</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Section Title
          </th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Updated</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody id="tableBody" class="bg-white divide-y divide-slate-100">
        <tr>
          <td colspan="5" class="px-6 py-10 text-center text-slate-400 font-medium empty-row">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Slide-in / Centered Modal -->
<div
  class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 transition-opacity"
  id="modalOverlay">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-hidden flex flex-col">

    <div class="flex justify-between items-center px-6 py-4 border-b border-slate-100 bg-slate-50">
      <h2 id="modalTitle" class="text-xl font-bold text-slate-800">New Content Block</h2>
      <button id="modalCloseBtn" type="button"
        class="text-slate-400 hover:text-slate-600 hover:bg-slate-200 p-1.5 rounded-lg transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="postForm" class="p-6 overflow-y-auto space-y-5">
      <input type="hidden" id="pageId" />

      <div>
        <label for="title" class="block text-sm font-semibold text-slate-700 mb-1">Page Title *</label>
        <input type="text" id="title" required
          class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-colors"
          placeholder="e.g. Home Page" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label for="sectionId" class="block text-sm font-semibold text-slate-700 mb-1">Section ID *</label>
          <input type="text" id="sectionId" required
            class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-colors"
            placeholder="hero, about, footer..." />
        </div>
        <div>
          <label for="sectionTitle" class="block text-sm font-semibold text-slate-700 mb-1">Section Title *</label>
          <input type="text" id="sectionTitle" required
            class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-colors"
            placeholder="e.g. Welcome to IRE Homes" />
        </div>
      </div>

      <div>
        <label for="sectionSubtitle" class="block text-sm font-semibold text-slate-700 mb-1">Section Subtitle</label>
        <input type="text" id="sectionSubtitle"
          class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-colors" />
      </div>

      <div>
        <label for="sectionBody" class="block text-sm font-semibold text-slate-700 mb-1">Section Body *</label>
        <textarea id="sectionBody" rows="5" required
          class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-colors resize-y"
          placeholder="Main content goes here..."></textarea>
      </div>

      <div>
        <label for="imageUrl" class="block text-sm font-semibold text-slate-700 mb-1">Image URL</label>
        <input type="text" id="imageUrl"
          class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-colors"
          placeholder="https://.../banner.jpg" />
      </div>

      <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" id="cancelBtn"
          class="px-5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-lg transition-colors focus:ring-2 focus:ring-slate-300">Cancel</button>
        <button type="submit"
          class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-sm">Save
          Content</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/page-content.js" defer></script>