<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-value"><%= stats.newsCount %></div>
    <div class="stat-label">Total News Posts</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= stats.publishedNews %></div>
    <div class="stat-label">Published News</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= stats.pageCount %></div>
    <div class="stat-label">Page Content Blocks</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= stats.houseCount %></div>
    <div class="stat-label">Total House Types</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= stats.availableHouses %></div>
    <div class="stat-label">Available House Types</div>
  </div>
</div>

<div class="card">
  <h2>Quick Links</h2>
  <div class="quick-links">
    <a href="/news-posts" class="quick-link">Manage News Posts &rarr;</a>
    <a href="/page-content" class="quick-link">Manage Page Content &rarr;</a>
    <a href="/house-types" class="quick-link">Manage House Types &rarr;</a>
  </div>
</div>
